# AWS Configuration
VUE_APP_AWS_REGION=us-east-1
VUE_APP_AWS_USER_POOL_ID=
VUE_APP_AWS_USER_POOL_WEB_CLIENT_ID=
VUE_APP_AWS_IDENTITY_POOL_ID=
VUE_APP_AWS_APPSYNC_GRAPHQL_ENDPOINT=
VUE_APP_AWS_APPSYNC_REGION=us-east-1
VUE_APP_AWS_APPSYNC_AUTHENTICATION_TYPE=AMAZON_COGNITO_USER_POOLS

# API Configuration
VUE_APP_API_BASE_URL=https://api.example.com
VUE_APP_PAYMENT_API_URL=https://payment-api.example.com
VUE_APP_BOOKING_API_URL=https://booking-api.example.com
VUE_APP_CATALOG_API_URL=https://catalog-api.example.com
VUE_APP_LOYALTY_API_URL=https://loyalty-api.example.com

# Feature Flags
VUE_APP_ENABLE_ANALYTICS=true
VUE_APP_ENABLE_DEBUG=false

# Application Configuration
VUE_APP_NAME="Serverless Airline"
VUE_APP_VERSION=2.0.0